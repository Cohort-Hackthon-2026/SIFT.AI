# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM synthesis (Google Gemini) ---
# REQUIRED for chat. Without it, chat streams a "service unavailable" message.
# Get one from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Primary model; the service auto-falls-back through its FALLBACK_MODELS list.
DEFAULT_LLM_MODEL=gemini-3.5-flash

# --- Web search (Exa AI) ---
# REQUIRED for ENHANCED mode. Without it, web search is skipped and the
# assistant answers from internal documents only. https://dashboard.exa.ai
EXA_API_KEY=

# --- Ahnlich AI proxy (vector search) ---
# Either set AHNLICH_ENDPOINT (host:port) or the HOST/PORT pair. When
# unreachable, an in-memory token-overlap fallback is used automatically.
AHNLICH_ENDPOINT=
AHNLICH_HOST=
AHNLICH_PORT=
USE_AHNLICH=
AHNLICH_STORE_NAME=

# Document registry (GET /documents, DELETE /documents/{id}).
# Any standard Postgres connection string works, e.g. a Neon pooled URL:
# postgresql://<user>:<password>@<host>/<db>?sslmode=require&channel_binding=require
DATABASE_URL=

# Search-result cache (optional). Leave blank to disable caching.
REDIS_URL=
SEARCH_CACHE_TTL_SECONDS=

# --- PDF file storage (Cloudflare R2, S3-compatible) ---
# Persists uploaded PDFs so GET /documents/{id}/file can serve them to the
# viewer. All three of ENDPOINT_URL/ACCESS_KEY_ID/SECRET_ACCESS_KEY must be
# set to enable; otherwise file storage is disabled (that endpoint returns 404).
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sift-ai-pdfs

# Max upload size in bytes (defaults to 20MB). Enforced server-side.
MAX_UPLOAD_SIZE_BYTES=

# Frontend origin(s) allowed to call this API (comma-separated).
CORS_ALLOWED_ORIGINS=

# --- Rate limiting (per authenticated user) ---
# Guards the chat/upload/search endpoints against abuse. Set ENABLED=false to
# disable entirely (e.g. local dev/tests).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30

# Whisper transcription (POST /api/v1/audio/transcribe)
WHISPER_MODEL_SIZE=
WHISPER_DEVICE=
WHISPER_COMPUTE_TYPE=

# --- Auth (Clerk) ---
# Every /api/v1/documents* and /api/v1/audio/transcribe request now requires
# a valid Clerk session token (Authorization: Bearer <token>). Find these in
# the Clerk Dashboard under Configure -> API Keys -> Advanced.
#
# JWKS URL - used to verify token signatures. Looks like:
# https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=

# Issuer - must exactly match the `iss` claim on every token. Same domain as
# above, without the /.well-known/jwks.json suffix, e.g.
# https://<your-instance>.clerk.accounts.dev
CLERK_ISSUER=

# Optional: comma-separated list of frontend origins allowed to mint tokens
# this API will accept (checked against the token's `azp` claim). Leave
# blank to skip this check entirely.
CLERK_AUTHORIZED_PARTIES=

# Set to false ONLY for local development without a Clerk account yet - all
# requests are then treated as a fixed "local-dev-user". Never set this to
# false anywhere real traffic could reach the API.
AUTH_ENABLED=
